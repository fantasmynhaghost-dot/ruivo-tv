{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruivotv.example/schema/addon-manifest-v1.json",
  "title": "RuivoTV Addon Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apiVersion", "id", "name", "description", "version", "developer", "compatibility", "capabilities", "catalog"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
    "developer": { "type": "string", "minLength": 1, "maxLength": 80 },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["minAppVersion"],
      "properties": {
        "minAppVersion": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$" },
        "maxAppVersion": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$" }
      }
    },
    "updateUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "iconUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "allowedHosts": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$" }
    },
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "enum": ["live", "movies", "series", "search"] }
    },
    "categories": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 48 }
    },
    "permissions": {
      "type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true,
      "items": { "enum": ["catalog.read", "stream.play", "images.read"] }
    },
    "releaseNotes": { "type": "string", "maxLength": 2000 },
    "catalog": {
      "type": "object", "additionalProperties": false, "required": ["path", "fields"],
      "properties": {
        "path": {
          "oneOf": [
            { "type": "string", "pattern": "^/(?!/)(?!.*(?:\\.\\.|\\\\|#)).*$", "maxLength": 512 },
            { "const": "package:catalog.json" }
          ]
        },
        "itemsPath": { "type": "string", "maxLength": 256, "pattern": "^(?!.*(?:\\.\\.|__proto__|constructor)).*$" },
        "fields": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "url"],
          "properties": {
            "id": { "$ref": "#/$defs/propertyPath" }, "name": { "$ref": "#/$defs/propertyPath" },
            "kind": { "$ref": "#/$defs/propertyPath" }, "url": { "$ref": "#/$defs/propertyPath" },
            "category": { "$ref": "#/$defs/propertyPath" }, "logo": { "$ref": "#/$defs/propertyPath" },
            "number": { "$ref": "#/$defs/propertyPath" }, "series": { "$ref": "#/$defs/propertyPath" },
            "season": { "$ref": "#/$defs/propertyPath" }, "episode": { "$ref": "#/$defs/propertyPath" },
            "duration": { "$ref": "#/$defs/propertyPath" }, "description": { "$ref": "#/$defs/propertyPath" },
            "year": { "$ref": "#/$defs/propertyPath" }, "rating": { "$ref": "#/$defs/propertyPath" },
            "schedule": { "$ref": "#/$defs/propertyPath" }
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "required": ["permissions"] }, "then": { "properties": { "permissions": { "allOf": [ { "contains": { "const": "catalog.read" } }, { "contains": { "const": "stream.play" } } ] } } } },
    { "if": { "required": ["iconUrl"] }, "then": { "properties": { "permissions": { "contains": { "const": "images.read" } } } } },
    { "if": { "properties": { "catalog": { "properties": { "path": { "const": "package:catalog.json" } } } } }, "then": { "properties": { "catalog": { "properties": { "path": { "const": "package:catalog.json" } } } } } }
  ],
  "$defs": {
    "propertyPath": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 128 }
  }
}
